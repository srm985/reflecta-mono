{
    "compilerOptions": {
        "declaration": true,
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "bundler",
        "outDir": "./declarations",
        "paths": {
            "@components/*": [
                "./src/components/*"
            ],
            "@constants": [
                "./src/constants.ts"
            ],
            "@modules/*": [
                "./src/modules/*"
            ],
            "@utils/*": [
                "./src/utils/*"
            ],
            "@styles/*": [
                "./src/styles/*"
            ]
        },
        "types": [
            "google.maps",
            "node"
        ],
        "rootDir": "./",
        "allowJs": false,
        "noEmit": false
    },
    "exclude": [
        "./dist/**/*"
    ],
    "extends": "../../tsconfig.json",
    "include": [
        "src/**/*",
        "src/*",
        "./*.js",
        ".storybook/*"
    ]
}
