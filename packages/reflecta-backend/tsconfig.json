{
    "compilerOptions": {
        "rootDir": "./",
        "esModuleInterop": true,
        "module": "Node16",
        "moduleResolution": "node16",
        "noUnusedParameters": false,
        "outDir": "./dist",
        "paths": {
            "@constants": [
                "./src/constants.ts"
            ],
            "@controllers/*": [
                "./src/controllers/*"
            ],
            "@middleware/*": [
                "./src/middleware/*"
            ],
            "@models/*": [
                "./src/models/*"
            ],
            "@services/*": [
                "./src/services/*"
            ],
            "@utils/*": [
                "./src/utils/*"
            ],
            "@types": [
                "./src/types.ts"
            ]
        },
        "types": [
            "google.maps",
            "node"
        ],
        "allowJs": false,
        "noEmit": false
    },
    "exclude": [
        "./dist/**/*"
    ],
    "extends": "../../tsconfig.json",
    "include": [
        "src/**/*",
        "src/*",
        "sequelize/*",
        "./*.js",
        "static/*"
    ],
    "ts-node": {
        "experimentalSpecifierResolution": "node"
    }
}
