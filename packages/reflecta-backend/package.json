{
  "author": "Sean McQuay",
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.16.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "mysql2": "^3.22.3",
    "openai": "^6.39.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "description": "Journaling application backend meant to help offer analysis and insights into journal entries.",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/google.maps": "^3.64.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.12.4",
    "node-gyp": "^12.3.0",
    "nodemon": "^3.1.14",
    "onchange": "^7.1.0",
    "sequelize": "^6.37.8",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ],
    "*.ts": [
      "eslint --fix"
    ]
  },
  "main": "index.js",
  "name": "reflecta-backend",
  "scripts": {
    "build": "tsc && tsc-alias",
    "config:local": "cross-env NODE_ENV=development",
    "develop": "cross-env NODE_ENV=development concurrently --raw \"nodemon\" \"npm:watch --silent\"",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "pre-commit": "cross-env FORCE_COLOR=true lint-staged",
    "start": "npm run develop",
    "update": "npm update --save/--save-dev",
    "watch": "onchange --delay 500 \"src/**/*.(ts|tsx)\" -- npm run lint --silent",
    "typecheck": "tsc --noEmit"
  },
  "version": "1.0.0"
}
