{
    "compilerOptions": {
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "bundler",
        "outDir": "./dist",
        "paths": {
            "@assets/*": [
                "./src/assets/*"
            ],
            "@components/*": [
                "./src/components/*"
            ],
            "@constants": [
                "./src/constants.ts"
            ],
            "@hooks": [
                "./src/hooks.ts"
            ],
            "@modules/*": [
                "./src/modules/*"
            ],
            "@routes": [
                "./src/routes.ts"
            ],
            "@services/*": [
                "./src/services/*"
            ],
            "@store/*": [
                "./src/store/*"
            ],
            "@types": [
                "./src/types.ts"
            ],
            "@utils/*": [
                "./src/utils/*"
            ],
            "@views/*": [
                "./src/views/*"
            ],
            "@components/*/types": [
                "../reflecta-components/declarations/src/components/*/types"
            ]
        },
        "types": [
            "google.maps",
            "node"
        ],
        "rootDir": "./",
        "allowJs": false,
        "noEmit": false
    },
    "exclude": [
        "./dist/**/*"
    ],
    "extends": "../../tsconfig.json",
    "include": [
        "src/**/*",
        "src/*",
        "./*.js",
        "./*.ts",
        "!src/components/remotes/**/*"
    ]
}
