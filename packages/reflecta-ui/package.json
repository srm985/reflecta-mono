{
  "author": "Sean McQuay",
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-regular-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@reduxjs/toolkit": "^2.12.0",
    "axios": "^1.16.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.15.1",
    "reflecta-components": "^1.0.0"
  },
  "description": "Journaling application UI meant to help offer analysis and insights into journal entries.",
  "devDependencies": {
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/google.maps": "^3.64.1",
    "@types/node": "^24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/webpack-env": "^1.18.8",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.4",
    "dotenv": "^17.4.2",
    "dotenv-webpack": "^9.0.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "html-webpack-plugin": "^5.6.7",
    "onchange": "^7.1.0",
    "postcss": "^8.5.15",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.8.3",
    "sass": "^1.100.0",
    "sass-loader": "^17.0.0",
    "style-loader": "^4.0.0",
    "stylelint": "^17.12.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-declaration-block-no-ignored-properties": "^3.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-scss": "^7.1.1",
    "ts-loader": "^9.5.7",
    "typescript": "^6.0.3",
    "webpack": "^5.107.1",
    "webpack-cli": "^7.0.2",
    "webpack-dev-server": "^5.2.4"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix"
    ],
    "*.scss": [
      "prettier --write",
      "stylelint --fix"
    ],
    "*.ts": [
      "eslint --fix"
    ],
    "*.tsx": [
      "eslint --fix"
    ]
  },
  "main": "index.js",
  "name": "reflecta-ui",
  "scripts": {
    "build": "webpack",
    "develop": "concurrently --raw \"npm:lint --silent\" \"webpack-dev-server --open --config ./webpack.config.js\" \"npm:watch --silent\"",
    "lint": "concurrently --raw \"npm:lint:js --silent\" \"npm:lint:scss --silent\"",
    "lint:fix": "npm run generate:remotes && concurrently --raw \"eslint . --ext .ts,.tsx,.js --fix\" \"stylelint src/**/*  --color --allow-empty-input --fix\"",
    "lint:js": "npm run generate:remotes && eslint . --ext .ts,.tsx,.js",
    "lint:scss": "stylelint src/**/* --color --allow-empty-input",
    "pre-commit": "cross-env FORCE_COLOR=true lint-staged",
    "prettier": "prettier --write \"src/**/*.scss\"",
    "start": "npm run develop",
    "update": "npm update --save/--save-dev",
    "watch": "concurrently --raw \"npm:watch:js --silent\" \"npm:watch:scss --silent\"",
    "watch:js": "onchange --delay 500 \"src/**/*.(ts|tsx)\" -- npm run lint:js --silent",
    "watch:prettier": "onchange --delay 500 \"src/**/*.scss\" -- npm run lint:scss --silent",
    "watch:scss": "onchange --delay 500 \"src/**/*.scss\" -- npm run lint:scss --silent",
    "typecheck": "npm run generate:remotes && tsc --noEmit",
    "generate:remotes": "node ./scripts/generateRemoteComponents.js"
  },
  "version": "1.0.0"
}
